<Window x:Class="VisualizationWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sorting Visualizer"
        Width="400"
        Height="800"
        Background="Black"
        WindowStartupLocation="Manual"
        Left="200"
        Top="20">

    <Grid>
        <StackPanel VerticalAlignment="Top" Margin="0,30,0,0">
            <TextBlock Text="Best Case: O(n log n)"
                       Foreground="Lime"
                       FontSize="18"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Average Case: O(n log n)"
                       Foreground="Lime"
                       FontSize="18"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Worst Case: O(n^2)"
                       Foreground="Lime"
                       FontSize="18"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="QUICK SORT"
                       Foreground="White"
                       FontSize="36"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="CountText"
                       Text="n = 70"
                       Foreground="White"
                       FontSize="16"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <Canvas x:Name="BarCanvas"
                VerticalAlignment="Bottom"
                Height="500"
                Margin="10"/>
    </Grid>
</Window>
