<Window x:Class="VisualizationWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maze Pathfinder"
        Width="500"
        Height="800"
        Background="Black"
        WindowStartupLocation="Manual"
        Left="30"
        Top="20">

    <Grid>

        <!-- HEADER -->
        <StackPanel VerticalAlignment="Top" Margin="0,20,0,0">

            <TextBlock Text="DIJKSTRA'S ALGORITHM"
                       Foreground="#00FF88"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Shortest Path in Weighted Graph"
                       Foreground="Gray"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,10"/>

            <!-- STATS PANEL -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10">

                <StackPanel Margin="15,0">
                    <TextBlock Text="Visited"
                               Foreground="Gray"
                               FontSize="12"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="VisitedText"
                               Text="0"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="15,0">
                    <TextBlock Text="Distance"
                               Foreground="Gray"
                               FontSize="12"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DistanceText"
                               Text="0"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="15,0">
                    <TextBlock Text="Status"
                               Foreground="Gray"
                               FontSize="12"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatusText"
                               Text="Generating..."
                               Foreground="#00FF88"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>

        </StackPanel>

        <!-- MAZE AREA -->
        <Canvas x:Name="BarCanvas"
                Margin="20,140,20,20"
                Background="Black"/>

    </Grid>
</Window>